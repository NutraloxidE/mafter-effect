# Mafter Effect — deploy:ssh の設定サンプル。実際の値は .env に書く（.env は gitignore 対象）。

# --- SSH deploy（scripts/deploy-ssh.mjs） ---
DEPLOY_HOST=root@ssh.gycp.party
DEPLOY_USER=
DEPLOY_PORT=10000
DEPLOY_PASSWORD=
DEPLOY_IDENTITY=
DEPLOY_LOCAL_PATH=dist
DEPLOY_REMOTE_PATH=~/mafter-effect
DEPLOY_SITE_HOST=
DEPLOY_TLS_EMAIL=
# deploy:ssh のたびに npm run build を実行してから配布する（トークン込みの dist を都度焼き直す）
DEPLOY_BUILD=true
DEPLOY_CLEAN=false
DEPLOY_ENABLE_WEB=true

# --- フィードバックループ（doc/feedback-loop.md） ---
# ベータ向け共有トークン。VITE_ プレフィックスの同名変数としてクライアントに焼き込まれるのが仕様
# （漏洩許容・秘密鍵ではない）。ゲート用の共有値 + サーバ側 rate limit で悪用を抑える。
# 悪用されたらこの値をローテして再 build + deploy するだけでよい。
FEEDBACK_INGEST_TOKEN=
VITE_FEEDBACK_TOKEN=${FEEDBACK_INGEST_TOKEN}
# リモートの jsonl 保存先（inbox は自動で /inbox を付与）
FEEDBACK_REMOTE_DIR=~/mafter-feedback
