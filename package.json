{
  "name": "mafter-effect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run build:player && vite build",
    "build:player": "vite build --config vite.player.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:ssh": "node scripts/deploy-ssh.mjs",
    "harvest:feedback": "node scripts/harvest-feedback.mjs",
    "summarize:feedback": "node scripts/summarize-feedback.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "jszip": "^3.10.1",
    "mp4-muxer": "^5.2.2",
    "opentype.js": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "ulid": "^2.3.0",
    "webm-muxer": "^5.1.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
