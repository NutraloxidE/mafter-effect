{
  "name": "mafter-effect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run build:player && vite build",
    "build:player": "vite build --config vite.player.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:ssh": "node scripts/deploy-ssh.mjs",
    "harvest:feedback": "node scripts/harvest-feedback.mjs",
    "summarize:feedback": "node scripts/summarize-feedback.mjs",
    "electron:build-main": "node electron/build.mjs",
    "electron:watch-main": "node electron/build.mjs --watch",
    "electron:dev": "concurrently -k \"cross-env ELECTRON_DEV_PORT=5183 vite\" \"npm run electron:watch-main\" \"wait-on http://localhost:5183 dist-electron/main.cjs && cross-env ELECTRON_RENDERER_URL=http://localhost:5183 nodemon --watch dist-electron --ext cjs --delay 300ms --exec electron .\"",
    "electron:start": "cross-env ELECTRON_FILE=1 vite build && npm run electron:build-main && electron .",
    "electron:dist": "cross-env ELECTRON_FILE=1 npm run build && npm run electron:build-main && electron-builder --win portable",
    "electron:dist:win": "cross-env ELECTRON_FILE=1 npm run build && npm run electron:build-main && electron-builder --win portable",
    "electron:dist:mac": "cross-env ELECTRON_FILE=1 npm run build && npm run electron:build-main && electron-builder --mac"
  },
  "build": {
    "appId": "party.gycp.maftereffect",
    "productName": "Mafter Effect",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "identity": null
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "earcut": "^3.2.3",
    "jszip": "^3.10.1",
    "libtess": "^1.2.2",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.4.1",
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "ulid": "^2.3.0",
    "webm-muxer": "^5.1.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.0.0",
    "nodemon": "^3.1.7",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wait-on": "^9.0.10"
  }
}
